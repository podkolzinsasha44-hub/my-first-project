/**
 * Заполнение трекера привычек за СЕНТЯБРЬ (лист gid=1036744341).
 *
 * Как запустить:
 *   1. В таблице: Расширения → Apps Script.
 *   2. Вставить этот код вместо содержимого, сохранить.
 *   3. Выбрать функцию fillSeptember → «Выполнить», разрешить доступ.
 *
 * Скрипт пишет ТОЛЬКО в пустые ячейки без формул — уже введённые
 * данные и формулы (длительность сна, итоги, «Прогресс») не трогаются.
 */

const SHEET_GID = 1036744341;
const FIRST_DAY_COL = 35; // AI = 1 сентября, …, BL = 30 сентября

// Номера строк в листе
const ROW = {
  sleep: 3,     // 😴 Уснул
  wake: 4,      // ⏰ Проснулся
  duration: 5,  // 🛌 Длительность сна (заполняется только если там нет формулы)
  ege: 12,      // 📚 Часы подготовки к ЕГЭ
  meal: 27,     // 🍽️ Время последнего приёма пищи
  tgPhone: 16, ttPhone: 17, ytPhone: 18,
  tgTablet: 21, ttTablet: 22, ytTablet: 23,
};

// ---- Данные: { день месяца: "ч:мм" } ----
const DATA = {
  sleep: { 4: "0:22", 5: "0:44", 7: "0:19", 8: "23:23", 9: "0:06", 10: "0:26", 12: "23:57", 13: "1:22", 14: "0:04", 15: "23:07", 16: "23:37", 17: "23:11", 18: "23:06", 19: "23:59", 20: "0:51", 21: "23:33", 23: "23:56", 24: "0:24", 25: "0:28", 26: "0:03" },
  wake: { 4: "6:39", 5: "8:53", 7: "6:37", 8: "6:26", 9: "6:36", 10: "6:31", 12: "8:21", 13: "8:46", 14: "6:32", 15: "6:41", 16: "6:44", 17: "6:27", 18: "6:43", 19: "8:39", 20: "9:09", 21: "6:42", 23: "6:33", 24: "6:46", 25: "6:34", 26: "8:22" },
  duration: { 4: "6:17", 5: "8:09", 7: "6:18", 8: "7:03", 9: "6:30", 10: "6:05", 12: "8:24", 13: "7:24", 14: "6:28", 15: "7:34", 16: "7:07", 17: "7:16", 18: "7:37", 19: "8:40", 20: "8:18", 21: "7:09", 23: "6:37", 24: "6:22", 25: "6:06", 26: "8:19" },
  ege: { 7: "3:41", 10: "4:51", 11: "2:48", 12: "3:42", 13: "4:33", 14: "0", 15: "2:12", 16: "2:59", 17: "4:52", 18: "5:37", 19: "2:21", 20: "3:19", 21: "2:50", 22: "5:14", 23: "1:50", 24: "0", 25: "0" },
  meal: { 8: "15:16", 9: "18:48", 10: "15:37", 11: "15:01", 12: "18:31", 13: "15:09", 14: "15:51", 15: "18:16", 16: "15:57", 17: "15:18", 18: "15:19", 19: "18:51", 20: "15:07", 21: "15:32", 22: "18:53", 23: "15:38", 24: "16:19", 25: "18:54", 26: "15:58" },

  // Экранное время — будет добавлено после разбора скриншотов
  tgPhone: {}, ttPhone: {}, ytPhone: {},
  tgTablet: {}, ttTablet: {}, ytTablet: {},
};

function fillSeptember() {
  const sheet = SpreadsheetApp.getActive().getSheets()
    .find(s => s.getSheetId() === SHEET_GID);
  if (!sheet) throw new Error('Лист с gid ' + SHEET_GID + ' не найден');

  let written = 0, skipped = 0;
  for (const key of Object.keys(DATA)) {
    for (const [day, value] of Object.entries(DATA[key])) {
      const cell = sheet.getRange(ROW[key], FIRST_DAY_COL + Number(day) - 1);
      if (cell.getFormula() || cell.getValue() !== '') { skipped++; continue; }
      cell.setValue(value); // строка "23:14" распознаётся как время, как при ручном вводе
      written++;
    }
  }
  SpreadsheetApp.getActive().toast('Записано: ' + written + ', пропущено (уже заполнено): ' + skipped);
}
